SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CodeForge -> private FreeLLMAPI gateway.
# Keep FreeLLMAPI private; do not expose its port directly to the public internet.
FREE_LLM_API_URL=http://localhost:3001/v1
FREE_LLM_API_KEY=freellmapi-your-unified-key

# chat_completions is the recommended default for CodeForge because it supports
# streaming + tool calling + vision through the gateway.
# Set to "responses" only when your configured gateway/models require the
# OpenAI Responses wire protocol.
FREE_LLM_API_WIRE_API=chat_completions
FREE_LLM_API_TIMEOUT=120
FREE_LLM_API_MAX_RETRIES=1

# Task routing. FreeLLMAPI owns the actual provider/model selection.
DEFAULT_MODEL=auto:balanced
PLANNING_MODEL=auto:smart
CODING_MODEL=auto:balanced
REVIEW_MODEL=auto:smart
DEBUG_MODEL=auto:reliable

APP_ENV=development
